{
  "name": "atelier",
  "version": "1.0.0",
  "description": "L'Atelier : apprendre le HTML, le CSS et le JavaScript en construisant son propre site.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=serveur --watch-path=contenu --watch-path=partage serveur/index.js",
    "dev:front": "vite",
    "build": "vite build",
    "start": "node serveur/index.js",
    "test": "vitest run",
    "test:navigateur": "node tests/navigateur/lancer.js",
    "captures": "node tests/navigateur/demo.js",
    "test:accessibilite": "node tests/navigateur/accessibilite.js"
  },
  "dependencies": {
