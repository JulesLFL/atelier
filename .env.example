# ---------------------------------------------------------------
#  L'Atelier — configuration. Copie ce fichier en « .env »
#  (ou mets ces variables dans « Environment variables » de la stack Portainer).
# ---------------------------------------------------------------

# Mot de passe du panneau mentor (10 caractères minimum).
MENTOR_PASSWORD=change-moi-vite

# Secret qui signe les sessions (64 caractères aléatoires).
# Génère-le avec :  openssl rand -hex 32
# Le changer déconnecte tout le monde (chaque élève devra réutiliser son lien).
SESSION_SECRET=

# Adresse publique du site (sert à fabriquer les liens d'accès et les liens des sites publiés).
PUBLIC_URL=https://latelier.juleslfl.dev

# Port de l'application sur ta machine / ton NAS.
PORT=30085

# --- Sauvegardes ---------------------------------------------------
# Clé de chiffrement des sauvegardes (20 caractères minimum, différente de SESSION_SECRET).
# FORTEMENT CONSEILLÉE. Génère-la avec :  openssl rand -base64 32
# ⚠️ Garde-la dans un gestionnaire de mots de passe : sans elle, les sauvegardes sont illisibles.
SAUVEGARDE_CLE=

# (Docker) Dossier du NAS où ranger les sauvegardes, ailleurs que la base.
# Vide = un volume Docker « atelier-sauvegardes ». Exemple : /mnt/NAS/sauvegardes/atelier
# (le dossier doit appartenir à l'utilisateur 1000 : chown -R 1000:1000 …)
CHEMIN_SAUVEGARDES=

# --- Alertes Discord (optionnel) -------------------------------------
# Salon Discord › Modifier le salon › Intégrations › Webhooks › Nouveau webhook › Copier l'URL
DISCORD_WEBHOOK_URL=
